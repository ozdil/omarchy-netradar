#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${HOME}/.local/bin/netradar-engine"
SHARE_DIR="${HOME}/.local/share/omarchy-netradar"
SYS_SHARE_DIR="/usr/share/omarchy-netradar"

# Fallback to system bin or project target if not in ~/.local/bin
if [[ ! -x "${BIN}" ]]; then
    if [[ -x "/usr/bin/netradar-engine" ]]; then
        BIN="/usr/bin/netradar-engine"
    elif [[ -x "${SCRIPT_DIR}/target/release/netradar-engine" ]]; then
        BIN="${SCRIPT_DIR}/target/release/netradar-engine"
    fi
fi

# Locate QML shell
if [[ -f "${SCRIPT_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${SCRIPT_DIR}/qml/shell.qml"
elif [[ -f "${SYS_SHARE_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${SYS_SHARE_DIR}/qml/shell.qml"
elif [[ -f "${SHARE_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${SHARE_DIR}/qml/shell.qml"
else
    SHELL_QML=""
fi

# If CLI arguments passed, delegate to binary directly
if [[ $# -gt 0 ]]; then
    exec "${BIN}" "$@"
fi

# Try quickshell IPC toggle if already running
if command -v quickshell >/dev/null 2>&1; then
    if quickshell ipc call ozdil.netradar toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

# Launch standalone GUI if quickshell exists
if command -v quickshell >/dev/null 2>&1 && [[ -n "${SHELL_QML}" ]]; then
    exec quickshell -p "${SHELL_QML}"
else
    exec "${BIN}" --status
fi
