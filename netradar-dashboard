#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="${HOME}/.local/bin/netradar-engine"
SHARE_DIR="${HOME}/.local/share/omarchy-netradar"
PLUGIN_DIR="${HOME}/.config/omarchy/plugins/ozdil.netradar"
DEV_DIR="${HOME}/Projects/omarchy/omarchy-netradar"
SYS_SHARE_DIR="/usr/share/omarchy-netradar"

if [[ ! -x "${BIN}" ]]; then
    if [[ -x "/usr/bin/netradar-engine" ]]; then
        BIN="/usr/bin/netradar-engine"
    elif [[ -x "${DEV_DIR}/target/release/netradar-engine" ]]; then
        BIN="${DEV_DIR}/target/release/netradar-engine"
    elif [[ -x "${SCRIPT_DIR}/netradar-engine" ]]; then
        BIN="${SCRIPT_DIR}/netradar-engine"
    fi
fi

export NETRADAR_ENGINE_BIN="${BIN}"

if [[ -f "${SCRIPT_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${SCRIPT_DIR}/qml/shell.qml"
elif [[ -f "${SHARE_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${SHARE_DIR}/qml/shell.qml"
elif [[ -f "${PLUGIN_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${PLUGIN_DIR}/qml/shell.qml"
elif [[ -f "${DEV_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${DEV_DIR}/qml/shell.qml"
elif [[ -f "${SYS_SHARE_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${SYS_SHARE_DIR}/qml/shell.qml"
else
    SHELL_QML=""
fi

# Try toggling existing dashboard window if already running
if command -v quickshell >/dev/null 2>&1 && [[ -n "${SHELL_QML}" ]]; then
    if quickshell ipc -p "${SHELL_QML}" call ozdil.netradar.window toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

# Launch standalone GUI dashboard if quickshell exists
if command -v quickshell >/dev/null 2>&1 && [[ -n "${SHELL_QML}" ]]; then
    exec quickshell -p "${SHELL_QML}"
else
    exec "${BIN}" --status
fi
