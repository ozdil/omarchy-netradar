#!/usr/bin/env bash
set -euo pipefail

BIN="${HOME}/.local/bin/netradar-engine"
PROJECT_DIR="/home/ozdil/Projects/omarchy-netradar"
SHARE_DIR="${HOME}/.local/share/omarchy-netradar"

if [[ ! -x "${BIN}" && -x "${PROJECT_DIR}/target/release/netradar-engine" ]]; then
    BIN="${PROJECT_DIR}/target/release/netradar-engine"
fi

if [[ -f "${PROJECT_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${PROJECT_DIR}/qml/shell.qml"
elif [[ -f "${SHARE_DIR}/qml/shell.qml" ]]; then
    SHELL_QML="${SHARE_DIR}/qml/shell.qml"
else
    SHELL_QML=""
fi

if [[ "${1:-}" != "--window" ]] && command -v quickshell >/dev/null 2>&1; then
    if quickshell ipc call ozdil.netradar toggle >/dev/null 2>&1; then
        exit 0
    fi
fi

if command -v quickshell >/dev/null 2>&1 && [[ -n "${SHELL_QML}" ]]; then
    exec quickshell -p "${SHELL_QML}"
else
    exec "${BIN}" --status
fi
